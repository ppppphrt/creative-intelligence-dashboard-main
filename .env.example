NODE_ENV=production

# Generate with: openssl rand -hex 48
JWT_SECRET=replace_with_a_long_random_string

# MySQL — use TiDB Cloud (free) or Railway MySQL plugin
# TiDB format:  mysql+ssl://user:pass@host:4000/database
# Railway format: mysql://user:pass@host:3306/database
DATABASE_URL=mysql://user:password@host:3306/creative_intelligence

# Meta Ads direct access token
# Get from: https://developers.facebook.com/tools/explorer
# Permissions needed: ads_read, ads_management
META_ACCESS_TOKEN=

# OAuth (Manus) — leave blank if not using Manus Auth
VITE_OAUTH_PORTAL_URL=
VITE_APP_ID=
OAUTH_SERVER_URL=
OWNER_OPEN_ID=

# Manus Forge API — leave blank if using direct Meta API
BUILT_IN_FORGE_API_URL=
BUILT_IN_FORGE_API_KEY=
